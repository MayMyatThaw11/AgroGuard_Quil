# Local AgriQill API configuration. Copy this file to .env and fill in real
# values there — .env is gitignored, this file is the tracked template and
# must only ever hold placeholders.
#
# The server defaults to AGRIQUILL_ENVIRONMENT=production: it refuses to start
# unless AGRIQUILL_USERS or AGRIQUILL_WRITE_TOKEN is set, and the built-in demo
# sign-in (Farm Manager) is switched off. For local work, uncomment the next
# line (`npm run start` from the workspace root already sets it for you).
# With it, leaving both tokens blank means open, no-sign-in local development.
# AGRIQUILL_ENVIRONMENT=development

# A single shared token that authenticates as an unnamed caller with every
# role (crew + manager) and access to every farm. Simple, but not
# individually revocable or auditable — prefer AGRIQUILL_USERS for anything
# beyond quick local testing.
AGRIQUILL_WRITE_TOKEN=

# Named access codes: "name:code:roles[:farm1,farm2]" entries separated by
# ";". roles is "crew", "manager", or "crew,manager". Omit the farm list (or
# use "*") for access to every farm.
#   AGRIQUILL_USERS=alice:alicecode:manager:*;bob:bobcode:crew:farm-1,farm-2
#
# The AgroGuard -> AgriQill telemetry bridge (see
# backend/agroguard/app/services/observation.py) authenticates this way too
# — give it its own crew-only entry rather than reusing AGRIQUILL_WRITE_TOKEN,
# so it can submit readings but never touch manager-only endpoints, and so
# it shows up under its own name in AgriQill's logs:
#   AGRIQUILL_USERS=agroguard-bridge:<generate-a-random-token>:crew:*
# then set the matching AGROGUARD_AGRIQUILL_BRIDGE_TOKEN in
# backend/agroguard/.env to the same value.
AGRIQUILL_USERS=

# LoRaWAN webhook tokens, one per network so a leak from one cannot forge the
# other (sent as the X-AgriQuill-Token header). AGRIQUILL_TELEMETRY_WEBHOOK_TOKEN
# still works as a shared fallback for a network with no token of its own.
# Readings are accepted only for sensors a farm contract declares.
AGRIQUILL_TELEMETRY_TTN_TOKEN=
AGRIQUILL_TELEMETRY_CHIRPSTACK_TOKEN=

# Farm quota (3 free farms, then Pro). Must match the AGROGUARD_* values in the AgroGuard API.
# Leave AGRIQUILL_AGROGUARD_URL blank in development to skip the quota.
AGRIQUILL_AGROGUARD_URL=
AGRIQUILL_AGROGUARD_JWT_SECRET=
AGRIQUILL_AGROGUARD_SERVICE_KEY=
