// Agronomic contract for the Delta Demo Cooperative, Maubin, Ayeyarwady.
// Written once by the buyer's agronomist; the scheduler computes the daily plan.
// Paddy boundaries are OpenStreetMap farmland ways (ODbL, (c) OpenStreetMap contributors),
// fetched 2026-10-14. Crop, stage and planting dates are example records for the demo.
// Thresholds marked TO VERIFY by the verifier need a local source before field use.

farm farm_ayeyarwady_demo {
    name: "Delta Demo Cooperative"
    country: MM
    location: [16.72834, 95.59059]
    standard: ASOA_ORGANIC

    hydrology {
        regime: AWD_SAFE
        trigger_irrig_below: -15 cm
        flowering_lock_depth: 3 cm .. 5 cm
        reflood_depth: 5 cm
        percolation: 3 mm/day
    }

    actuation_gates {
        max_wind_speed: 5.5 m/s
        valid_delta_t: 2.0 C .. 8.0 C
        max_rain_6h_post: 10.0 mm
    }

    yield_logic {
        max_canopy_nitrogen: 85 kg/ha
        min_marginal_roi: 1.5x
    }

    sensors {
        wind: "ws-01"
    }

    schedule {
        crew: 2
        irrigate: 3 h
        drain: 2 h
        spray: 2 h
        scout: 1 h
        harvest: 8 h
    }
}
parcel PD-01 {
    osm: "way/652768658"
    area: 0.35 ha
    crop_id: rice_lowland
    stage: Ripening
    planted: "2026-06-24"
    boundary: [[16.730844, 95.597508], [16.730959, 95.598255], [16.730581, 95.598427], [16.730507, 95.59829], [16.730552, 95.59765], [16.730844, 95.597508]]
    sensors { water_depth: "PD-01-tube" }
}

