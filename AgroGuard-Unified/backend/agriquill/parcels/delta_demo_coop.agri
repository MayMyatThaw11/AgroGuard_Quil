// Mixed farming. Herd sizes are example records; the cooperative replaces them with its own counts.
herd FISH-04 { kind: fish species: "Nile tilapia" count: 300 paddy: PD-04 min_water: 10 cm min_oxygen: 3 mg/L }
herd SHRIMP-07 { kind: shrimp species: "Black tiger shrimp" count: 2000 paddy: PD-07 min_water: 15 cm min_oxygen: 4 mg/L }
herd DUCK-06 { kind: ducks count: 150 paddy: PD-06 }

asset P-01 { kind: pump label: "Intake pump" serves: [PD-01, PD-02, PD-03, PD-04, PD-05, PD-06, PD-07] }
asset G-03 { kind: gate label: "Paddy inlet" serves: [PD-02, PD-03] }
asset S-01 { kind: sluice label: "Outlet" serves: [PD-04, PD-07] }
asset S-02 { kind: sluice label: "Inlet sluice" serves: [PD-06, PD-07] }
asset D-01 { kind: drone label: "Drone" }
asset T-01 { kind: tractor label: "Tractor" }
asset R-02 { kind: robot label: "Field robot" }