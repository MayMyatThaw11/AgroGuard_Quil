# Local AgroGuard API configuration. Copy this file to .env and fill in real
# values there — .env is gitignored, this file is the tracked template and
# must only ever hold placeholders.
AGROGUARD_DATABASE_URL=postgresql://user:password@localhost:5432/agroguard
AGROGUARD_INITIALIZE_DATABASE=false
# Health updates + photos (GridFS). `docker compose up -d mongo` from the workspace root.
AGROGUARD_MONGO_URL=mongodb://localhost:27017
AGROGUARD_MONGO_DATABASE=agroguard
AGROGUARD_CORS_ORIGINS=["http://localhost:5173"]

# Optional integrations. Leave blank to use the built-in fallbacks.
# LLM provider: works with any OpenAI-compatible /chat/completions endpoint.
#   Default: Groq free tier. Get a key at https://console.groq.com/keys and put
#   it in .env (never in this file).
#   Groq retired the Llama 3.x models from the free tier on 2026-08-16; see
#   https://console.groq.com/docs/deprecations before changing models.
#   Local via Ollama (no API key/cost, found in the embedded-backend reconciliation):
#     AGROGUARD_LLM_ENDPOINT=http://localhost:11434/v1, AGROGUARD_LLM_MODEL=gemma3:latest
AGROGUARD_LLM_API_KEY=
AGROGUARD_LLM_ENDPOINT=https://api.groq.com/openai/v1
AGROGUARD_LLM_MODEL=openai/gpt-oss-120b
# Farming-only topic check that runs before each chat answer (same endpoint and key).
# With Ollama, set the model to a local one or set this to false.
AGROGUARD_LLM_TOPIC_GUARD_ENABLED=true
AGROGUARD_LLM_TOPIC_GUARD_MODEL=openai/gpt-oss-20b
AGROGUARD_OPENWEATHER_API_KEY=
AGROGUARD_TELEGRAM_BOT_TOKEN=
AGROGUARD_TELEGRAM_CHAT_ID=

# AgriQill telemetry bridge: forwards each ingested sensor reading into
# AgriQill's telemetry store over HTTP. Leave the token blank to disable
# (default) — ingestion works exactly the same either way, this is purely
# additive. To enable: give the bridge its own crew-only credential in
# AgriQill's AGRIQUILL_USERS (see backend/agriquill/.env.example) and put
# that same value here.
AGROGUARD_AGRIQUILL_API_URL=http://localhost:8010
AGROGUARD_AGRIQUILL_BRIDGE_TOKEN=
AGROGUARD_AGRIQUILL_BRIDGE_REPORTER=agroguard-bridge
