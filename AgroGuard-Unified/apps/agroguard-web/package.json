    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.18.1",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "6.14.0",
    "react": "^19.3.0",
